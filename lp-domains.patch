From 9875b80bfa6cf0cf6e9012ac4b2009fa444455f7 Mon Sep 17 00:00:00 2001
From: Grok <grok-export@users.noreply.github.com>
Date: Mon, 21 Sep 2026 11:49:14 +0000
Subject: [PATCH] Create LP domains with older cPanel APIs and attach proxy
 includes.

WHM create_addon_domain plus ensure_vhost_includes so cart.example.com hits Node instead of the empty docroot. Hide Perl traces in the dashboard.
---
 scripts/kaliaren-connect-domain.sh | 40 +++++++++++++----
 src/lib/cpanel.ts                  | 72 ++++++++++++++++++++++--------
 2 files changed, 84 insertions(+), 28 deletions(-)

diff --git a/scripts/kaliaren-connect-domain.sh b/scripts/kaliaren-connect-domain.sh
index 31a3d87..21f5bea 100644
--- a/scripts/kaliaren-connect-domain.sh
+++ b/scripts/kaliaren-connect-domain.sh
@@ -1,6 +1,5 @@
 #!/bin/bash
-# Once on VPS: install to /usr/local/sbin/kaliaren-connect-domain
-# sudoers: dewastoreid ALL=(root) NOPASSWD: /usr/local/sbin/kaliaren-connect-domain
+# Install once: /usr/local/sbin/kaliaren-connect-domain
 set -euo pipefail
 DOMAIN="${1:-}"
 USER="${KALIAREN_CPANEL_USER:-dewastoreid}"
@@ -8,18 +7,41 @@ if [[ ! "$DOMAIN" =~ ^[a-z0-9.-]+\.[a-z]{2,}$ ]]; then
   echo "domain tidak valid" >&2
   exit 1
 fi
-STD="/etc/apache2/conf.d/userdata/std/2_4/${USER}/${DOMAIN}"
-SSL="/etc/apache2/conf.d/userdata/ssl/2_4/${USER}/${DOMAIN}"
-mkdir -p "$STD" "$SSL"
-cat > "$STD/proxy.conf" <<'EOF'
+SUB="${DOMAIN%%.*}"
+SUB="${SUB//[^a-z0-9-]/}"
+[[ -n "$SUB" ]] || SUB="lp"
+DOC="/home/${USER}/public_html/${DOMAIN}"
+
+# Create the domain on the account if missing (cPanel UAPI modules vary by version).
+uapi --user="$USER" Domain add_domain domain="$DOMAIN" >/tmp/kaliaren-uapi.log 2>&1 || true
+uapi --user="$USER" Park park domain="$DOMAIN" >>/tmp/kaliaren-uapi.log 2>&1 || true
+if command -v whmapi1 >/dev/null 2>&1; then
+  whmapi1 create_addon_domain domain="$DOMAIN" subdomain="${SUB}" dir="$DOC" \
+    >>/tmp/kaliaren-uapi.log 2>&1 || true
+fi
+mkdir -p "$DOC"
+
+write_proxy() {
+  local dir="$1"
+  mkdir -p "$dir"
+  cat > "$dir/proxy.conf" <<'EOF'
 ProxyPreserveHost On
 RequestHeader set X-Forwarded-Proto "https"
 ProxyPass / http://127.0.0.1:3000/
 ProxyPassReverse / http://127.0.0.1:3000/
 EOF
-cp "$STD/proxy.conf" "$SSL/proxy.conf"
+}
+
+STD="/etc/apache2/conf.d/userdata/std/2_4/${USER}/${DOMAIN}"
+SSL="/etc/apache2/conf.d/userdata/ssl/2_4/${USER}/${DOMAIN}"
+write_proxy "$STD"
+write_proxy "$SSL"
+
+if [[ -x /scripts/ensure_vhost_includes ]]; then
+  /scripts/ensure_vhost_includes --user="$USER" >/dev/null 2>&1 || true
+fi
 if [[ -x /scripts/rebuildhttpdconf ]]; then
-  /scripts/rebuildhttpdconf >/dev/null
-  /scripts/restartsrv_httpd >/dev/null
+  /scripts/rebuildhttpdconf
+  /scripts/restartsrv_httpd
 fi
 echo "ok $DOMAIN"
diff --git a/src/lib/cpanel.ts b/src/lib/cpanel.ts
index b143d0b..910c10f 100644
--- a/src/lib/cpanel.ts
+++ b/src/lib/cpanel.ts
@@ -76,31 +76,65 @@ function namesOf(value: string[] | Record<string, string> | undefined): string[]
 }
 
 export async function cpanelListDomains(cfg: CpanelConfig): Promise<CpanelResult<string[]>> {
-  const res = await cpanelExecute<CpanelDomainList>(cfg, "Domain", "list_domains");
-  if (!res.ok || !res.data) return { ok: res.ok, data: [], error: res.error };
-  const list = [
-    res.data.main_domain ?? "",
-    ...namesOf(res.data.addon_domains),
-    ...(res.data.sub_domains ?? []),
-    ...(res.data.parked_domains ?? []),
-  ]
-    .map((s) => s.trim().toLowerCase())
-    .filter(Boolean);
-  return { ok: true, data: [...new Set(list)], error: "" };
+  const attempts: Array<[string, string]> = [
+    ["DomainInfo", "list_domains"],
+    ["Domain", "list_domains"],
+    ["DomainInfo", "domains_data"],
+  ];
+  let last = "cPanel list domain gagal";
+  for (const [mod, fn] of attempts) {
+    const res = await cpanelExecute<CpanelDomainList>(cfg, mod, fn);
+    if (!res.ok || !res.data) {
+      last = shortErr(res.error);
+      continue;
+    }
+    const data = res.data as CpanelDomainList & { data?: CpanelDomainList };
+    const block = data.main_domain ? data : data.data ?? data;
+    const list = [
+      block.main_domain ?? "",
+      ...namesOf(block.addon_domains),
+      ...(block.sub_domains ?? []),
+      ...(block.parked_domains ?? []),
+    ]
+      .map((s) => s.trim().toLowerCase())
+      .filter(Boolean);
+    return { ok: true, data: [...new Set(list)], error: "" };
+  }
+  return { ok: false, data: [], error: last };
 }
 
 export async function cpanelAddDomain(
   cfg: CpanelConfig,
   host: string,
 ): Promise<CpanelResult<unknown>> {
-  const added = await cpanelExecute(cfg, "Domain", "add_domain", { domain: host });
-  if (added.ok) return added;
-  const sub = host.split(".")[0] || "lp";
-  return cpanelExecute(cfg, "AddonDomain", "addaddondomain", {
-    newdomain: host,
-    subdomain: sub.replace(/[^a-z0-9-]/g, "").slice(0, 30) || "lp",
-    dir: `public_html/${host}`,
-  });
+  const sub = (host.split(".")[0] || "lp").replace(/[^a-z0-9-]/g, "").slice(0, 30) || "lp";
+  const attempts: Array<[string, string, Record<string, string>]> = [
+    ["Domain", "add_domain", { domain: host }],
+    ["Park", "park", { domain: host }],
+    [
+      "AddonDomain",
+      "addaddondomain",
+      { newdomain: host, subdomain: sub, dir: `public_html/${host}` },
+    ],
+    [
+      "SubDomain",
+      "addsubdomain",
+      { domain: sub, rootdomain: host.split(".").slice(1).join("."), dir: `public_html/${host}` },
+    ],
+  ];
+  let last = "cPanel tidak bisa membuat domain";
+  for (const [mod, fn, params] of attempts) {
+    const res = await cpanelExecute(cfg, mod, fn, params);
+    if (res.ok) return res;
+    last = shortErr(res.error);
+  }
+  return { ok: false, data: null, error: last };
+}
+
+function shortErr(raw: string): string {
+  const line = raw.split("\n")[0]?.trim() ?? raw;
+  if (line.length > 180) return `${line.slice(0, 177)}…`;
+  return line;
 }
 
 export async function cpanelDeleteDomain(
